{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ALASv2_DB;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;Encrypt=True",
    "WebLoanConnection": "Server=localhost;Database=webloan;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;Encrypt=True",
    "Redis": "localhost:6379,abortConnect=false",
    "RabbitMQ": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-at-least-32-characters-long-for-hmac-sha256",
    "Issuer": "EBI.ALAS.V2",
    "Audience": "EBI.ALAS.V2.Frontend",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "AbsoluteSessionExpiryDays": 14
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000", "http://localhost:3000"]
  },
  "Workflow": {
    "RequireRecommendation": false,
    "SlaForRecommendationHours": 4,
    "SlaForCheckingHours": 8,
    "SlaForApprovalHours": 8,
    "SlaForRevisionHours": 24,
    "SlaForDisbursementHours": 24
  },
  "Queue": {
    "MaxConcurrentAssignments": 5,
    "AutoReleaseMinutes": 60,
    "ReconciliationIntervalMinutes": 15
  },
  "Security": {
    "AdminAllowedIps": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "EBI.ALAS.Api"
  }
}